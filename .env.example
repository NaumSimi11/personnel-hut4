# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings → API). Never commit real values.

# Browser-safe (Vite bundles VITE_* into the frontend; RLS is the access gate)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only — privileged, bypasses RLS. Keep out of any frontend code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Postgres connection string (Dashboard → Connect → Session pooler URI).
# Needed only for applying migrations / admin scripts.
SUPABASE_DB_URL=

# Invite-door allowlist (comma-separated email domains; empty admits nobody)
COMPANY_EMAIL_DOMAINS=
# Public URL used in credential emails
APP_BASE_URL=
# Optional: enable credential emails via Resend
RESEND_API_KEY=
EMAIL_FROM=

# E2E test login for app/ Playwright tests.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Careers intake abuse limits (per hour; in-memory in the auth service).
# CAREERS_RATE_IP_PER_HOUR=30
# CAREERS_RATE_EMAIL_PER_HOUR=3
# Set to true when the auth service runs behind a reverse proxy (client IP
# from X-Forwarded-For; the careers rate limit depends on it).
# TRUST_PROXY=false
